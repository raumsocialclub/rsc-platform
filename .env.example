# 이 파일을 복사해 .env.local 로 저장한 뒤 값을 채웁니다. (.env.local 은 git에 올라가지 않습니다)
# 각 값을 받는 방법은 SETUP.md 를 참고하세요. M0(골격) 단계에서는 비워 두어도 화면이 뜹니다.

# --- Supabase (M2부터 필요) ---
# Supabase 대시보드 → 프로젝트(rsc-platform) → Project Settings → API 에서 복사
NEXT_PUBLIC_SUPABASE_URL=https://vfjpouuwvwgiqpwttyup.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=      # "anon public" 키 (공개용, 브라우저에서도 사용)
SUPABASE_SERVICE_ROLE_KEY=          # "service_role" 키. 서버 전용. 절대 NEXT_PUBLIC_ 붙이지 않음. M3부터 필수

# --- 소셜 로그인 (키 준비되면 Supabase Providers 에 등록 후 여기서 켜기. 예: kakao,google) ---
NEXT_PUBLIC_AUTH_PROVIDERS=

# --- 토스페이먼츠 (M6부터 필요) ---
NEXT_PUBLIC_TOSS_CLIENT_KEY=test_gck_docs_Ovk5rk1EwkEbP0W43n07xlzm   # 문서 공용 테스트 키. 가맹점 키(test_gck_… → live_gck_…)로 교체
TOSS_SECRET_KEY=test_gsk_docs_OaPz8L5KdmQXkzRz3y47BMw6           # 문서 공용 테스트 키. 가맹점 키(test_gsk_… → live_gsk_…)로 교체. 서버 전용
TOSS_WEBHOOK_SECRET=                # 선택. 넣으면 웹훅 URL 을 /api/payments/webhook?key=<값> 으로 등록

# --- 알림 (M4부터 이메일, 알림톡은 2차) ---
RESEND_API_KEY=
SOLAPI_API_KEY=
SOLAPI_API_SECRET=
SOLAPI_SENDER=
KAKAO_PF_ID=

# --- 사이트 주소 ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
